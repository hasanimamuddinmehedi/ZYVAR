# Sign in to Ollama first with: ollama signin
# The cloud model is used through the authenticated local Ollama server.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:cloud
# Required for live web search. Create a key at https://ollama.com/settings/keys.
# Keep this server-side only; never add it to a VITE_* variable.
OLLAMA_API_KEY=replace_with_your_ollama_api_key
