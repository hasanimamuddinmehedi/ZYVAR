# Local development: use the signed-in local Ollama server and `gemma4:cloud`.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:cloud
# For Render, set OLLAMA_BASE_URL=https://ollama.com and OLLAMA_MODEL=gemma4:31b.
# Required for direct Ollama Cloud chat and live web search. Create a key at
# https://ollama.com/settings/keys.
# Keep this server-side only; never add it to a VITE_* variable.
OLLAMA_API_KEY=replace_with_your_ollama_api_key
